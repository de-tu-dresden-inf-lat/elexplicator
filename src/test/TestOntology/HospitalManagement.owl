            </ObjectSomeValuesFrom>
        </ObjectIntersectionOf>
        <Class IRI="#Psychiatrist"/>
    </SubClassOf>
    <SubClassOf>
        <ObjectIntersectionOf>
            <Class IRI="#Staff"/>
            <ObjectSomeValuesFrom>
                <ObjectProperty IRI="#worksIn"/>
                <Class IRI="#OperatingRoom"/>
            </ObjectSomeValuesFrom>
        </ObjectIntersectionOf>
        <Class IRI="#Surgeon"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#Surgeon"/>
        <ObjectSomeValuesFrom>
