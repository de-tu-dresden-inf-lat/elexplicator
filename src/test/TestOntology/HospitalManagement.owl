        <ObjectProperty IRI="#assistsIn"/>
        <ObjectProperty IRI="#worksIn"/>
    </SubObjectPropertyOf>

    <SubClassOf>
        <ObjectIntersectionOf>
            <Class IRI="#Doctor"/>
            <ObjectSomeValuesFrom>
                <ObjectProperty IRI="#specializedIn"/>
                <Class IRI="#InternalMedicine"/>
            </ObjectSomeValuesFrom>
        </ObjectIntersectionOf>
        <Class IRI="#Physician"/>
    </SubClassOf>

    <SubClassOf>
        <ObjectIntersectionOf>
            <Class IRI="#Doctor"/>
            <ObjectSomeValuesFrom>
