            <ObjectSomeValuesFrom>
                <ObjectProperty IRI="#attends"/>
                <Class IRI="#PsychiatricPatient"/>
            </ObjectSomeValuesFrom>
        </ObjectIntersectionOf>
        <Class IRI="#Psychiatrist"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#Anasthesiologist"/>
        <ObjectSomeValuesFrom>
            <ObjectProperty IRI="#attends"/>            
            <ObjectUnionOf>
                <Class IRI="#SurgicalPatient"/>
                <Class IRI="#EmergencyPatient"/>
            </ObjectUnionOf>
        </ObjectSomeValuesFrom>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#Surgeon"/>
        <ObjectSomeValuesFrom>
            <ObjectProperty IRI="#operatesOn"/>
            <Class IRI="#SurgicalPatient"/>
        </ObjectSomeValuesFrom>
    </SubClassOf>
    
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#worksIn"/>
        <Class IRI="#Staff"/>
    </ObjectPropertyDomain>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#admittedTo"/>
        <Class IRI="#Patient"/>
    </ObjectPropertyDomain>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#operatesOn"/>
        <Class IRI="#Surgeon"/>
    </ObjectPropertyDomain>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#attends"/>
        <ObjectUnionOf>
            <Class IRI="#Doctor"/>
            <Class IRI="#Nurse"/>
        </ObjectUnionOf>
    </ObjectPropertyDomain>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#consults"/>
        <Class IRI="#Doctor"/>
    </ObjectPropertyDomain>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#worksIn"/>
        <Class IRI="#Areas"/>
    </ObjectPropertyRange>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#admittedTo"/>
        <Class IRI="#Areas"/>
    </ObjectPropertyRange>
