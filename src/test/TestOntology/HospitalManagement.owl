                <Class IRI="#OperatingRoom"/>
                <Class IRI="#EmergencyRoom"/>
                <Class IRI="#SurgicalWard"/>
                <Class IRI="#PsychiatricWard"/>
            </ObjectUnionOf>
        </ObjectSomeValuesFrom>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#Janitor"/>
        <ObjectSomeValuesFrom>
            <ObjectProperty IRI="#cleansIn"/>
            <Class IRI="#Areas"/>
        </ObjectSomeValuesFrom>
    </SubClassOf>
    <SubClassOf>
        <ObjectIntersectionOf>
            <Class IRI="#Patient"/>
            <ObjectSomeValuesFrom>
                <ObjectProperty IRI="#admittedTo"/>
                <Class IRI="#SurgicalWard"/>
            </ObjectSomeValuesFrom>
        </ObjectIntersectionOf>
        <Class IRI="#SurgicalPatient"/>
    </SubClassOf>
    <SubClassOf>
        <ObjectIntersectionOf>
            <Class IRI="#Patient"/>
            <ObjectSomeValuesFrom>
                <ObjectProperty IRI="#admittedTo"/>
                <Class IRI="#PsychiatricWard"/>
            </ObjectSomeValuesFrom>
        </ObjectIntersectionOf>
        <Class IRI="#PsychiatricPatient"/>
    </SubClassOf>
    <SubClassOf>
        <ObjectIntersectionOf>
            <Class IRI="#Patient"/>
            <ObjectSomeValuesFrom>
                <ObjectProperty IRI="#admittedTo"/>
                <Class IRI="#EmergencyRoom"/>
            </ObjectSomeValuesFrom>
        </ObjectIntersectionOf>
        <Class IRI="#EmergencyPatient"/>
