                <Class IRI="#Surgery"/>
            </ObjectSomeValuesFrom>
        </ObjectIntersectionOf>
        <Class IRI="#Surgeon"/>
    </SubClassOf>

    <SubClassOf>
        <Class IRI="#Surgeon"/>
