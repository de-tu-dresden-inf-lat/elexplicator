    <SubObjectPropertyOf>
        <ObjectProperty IRI="#treats"/>
        <ObjectProperty IRI="#attends"/>
    </SubObjectPropertyOf>
    <SubObjectPropertyOf>
        <ObjectProperty IRI="#operatesOn"/>
        <ObjectProperty IRI="#attends"/>
    </SubObjectPropertyOf>
    <SubObjectPropertyOf>
        <ObjectProperty IRI="#consults"/>
        <ObjectProperty IRI="#attends"/>
    </SubObjectPropertyOf>
    <SubObjectPropertyOf>
