            <Class IRI="#OperatingRoom"/>
        </ObjectSomeValuesFrom>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#Anasthesiologist"/>
        <ObjectSomeValuesFrom>
            <ObjectProperty IRI="#monitorsIn"/>
            <Class IRI="#OperatingRoom"/>
        </ObjectSomeValuesFrom>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#Nurse"/>
        <ObjectSomeValuesFrom>
            <ObjectProperty IRI="#assistsIn"/>
