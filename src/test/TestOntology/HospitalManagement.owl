        <Class IRI="#Patient"/>
    </ObjectPropertyRange>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#operatesIn"/>
        <Class IRI="#OperatingRoom"/>
    </ObjectPropertyRange>
</Ontology>

