     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     ontologyIRI="http://subPizza">
    <Prefix name="" IRI="http://subPizza#"/>
    <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>
    <Prefix name="rdf" IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
    <Prefix name="xml" IRI="http://www.w3.org/XML/1998/namespace"/>
    <Prefix name="xsd" IRI="http://www.w3.org/2001/XMLSchema#"/>
    <Prefix name="rdfs" IRI="http://www.w3.org/2000/01/rdf-schema#"/>
    <DisjointClasses>
        <Class IRI="#IceCream"/>
        <Class IRI="#Pizza"/>
        <Class IRI="#PizzaBase"/>
        <Class IRI="#PizzaTopping"/>
    </DisjointClasses>

    <SubClassOf>
        <Class IRI="#IceCream"/>
        <ObjectSomeValuesFrom>
            <ObjectProperty IRI="#hasTopping"/>
            <Class IRI="#FruitTopping"/>
        </ObjectSomeValuesFrom>
    </SubClassOf>

    <EquivalentClasses>
        <Class IRI="#Spiciness"/>
        <ObjectUnionOf>
            <Class IRI="#Hot"/>
            <Class IRI="#Medium"/>
            <Class IRI="#Mild"/>
        </ObjectUnionOf>
    </EquivalentClasses>
    <EquivalentClasses>
        <Class IRI="#SpicyIceCream"/>
        <ObjectIntersectionOf>
            <Class IRI="#IceCream"/>
            <ObjectSomeValuesFrom>
                <ObjectProperty IRI="#hasSpiciness"/>
                <Class IRI="#Hot"/>
            </ObjectSomeValuesFrom>
        </ObjectIntersectionOf>
    </EquivalentClasses>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#hasTopping"/>
        <Class IRI="#Pizza"/>
    </ObjectPropertyDomain>
    <SubClassOf>
        <Class IRI="#FruitTopping"/>
        <Class IRI="#PizzaTopping"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#VegetarianTopping"/>
        <Class IRI="#PizzaTopping"/>
    </SubClassOf>    
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#hasBase"/>
        <Class IRI="#Pizza"/>
    </ObjectPropertyDomain>
</Ontology>



